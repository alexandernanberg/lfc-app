# --- Storage (durable) -------------------------------------------------------
# Upstash Redis REST credentials. Without these the service falls back to an
# in-memory store that loses all device tokens on restart — fine for local dev,
# required for production. Create a free database at https://upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cron security -----------------------------------------------------------
# Shared secret protecting the /cron/poll endpoint. Whatever schedules the poll
# (QStash, GitHub Actions, Vercel Cron — see README) must send it as
# `Authorization: Bearer <CRON_SECRET>`. Leave blank locally to call the
# endpoint without auth.
CRON_SECRET=

# --- Expo push (optional) ----------------------------------------------------
# Only needed if you enable "Enhanced Security for Push Notifications" in Expo.
EXPO_ACCESS_TOKEN=

# --- Tuning (optional) -------------------------------------------------------
# LFC_API_URL=https://www.lfc.se/webapi
# POLL_ITEMS=10
# MAX_NOTIFICATIONS_PER_POLL=5

# --- Local dev only ----------------------------------------------------------
# PORT=8787
# Emulate Vercel Cron locally by polling every N ms (e.g. 60000). Off if unset.
# LOCAL_POLL_MS=
