# --- Storage (durable) -------------------------------------------------------
# Upstash Redis REST credentials. Required in production — the service refuses
# to start on Vercel without them, since the in-memory fallback can't work
# across serverless invocations. Create a free database at https://upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scheduling (Inngest) ----------------------------------------------------
# Inngest runs the recurring poll + receipt jobs by calling /api/inngest. Get
# these from https://app.inngest.com (Manage > Signing key / Event keys). The
# SDK reads them from the environment automatically. Leave blank locally and use
# the Inngest dev server (`npx inngest-cli@latest dev`) instead.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Expo push (optional) ----------------------------------------------------
# Only needed if you enable "Enhanced Security for Push Notifications" in Expo.
EXPO_ACCESS_TOKEN=

# --- Tuning (optional) -------------------------------------------------------
# LFC_API_URL=https://www.lfc.se/webapi
# POLL_ITEMS=10
# MAX_NOTIFICATIONS_PER_POLL=5

# --- Local dev only ----------------------------------------------------------
# PORT=8787
# Poll on a plain interval every N ms (e.g. 60000), without running Inngest.
# LOCAL_POLL_MS=
