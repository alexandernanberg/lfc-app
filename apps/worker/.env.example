# These are validated on startup against the schema in src/env.ts (@t3-oss/env-
# core + zod). A missing or malformed value fails immediately with a message
# naming every offending key, rather than breaking later at runtime.
#
# --- Storage (required) ------------------------------------------------------
# Upstash Redis REST credentials. REQUIRED, including locally — there is no
# in-memory fallback. Create a free database at https://upstash.com (a separate
# dev one is fine).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scheduling (Inngest) ----------------------------------------------------
# Inngest runs the recurring poll + receipt jobs by calling /api/inngest. Get
# these from https://app.inngest.com (Manage > Signing key / Event keys). The
# SDK reads them from the environment automatically. Leave blank locally and use
# the Inngest dev server (`npx inngest-cli@latest dev`) instead.
INNGEST_SIGNING_KEY=
INNGEST_EVENT_KEY=

# --- Expo push (optional) ----------------------------------------------------
# Only needed if you enable "Enhanced Security for Push Notifications" in Expo.
EXPO_ACCESS_TOKEN=

# --- Tuning (optional) -------------------------------------------------------
# LFC_API_URL=https://www.lfc.se/webapi
# POLL_ITEMS=10
# MAX_NOTIFICATIONS_PER_POLL=5

# --- Local dev only ----------------------------------------------------------
# PORT=8787
# Poll on a plain interval every N ms (e.g. 60000), without running Inngest.
# LOCAL_POLL_MS=
